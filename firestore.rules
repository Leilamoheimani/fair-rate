rules_version = '2';

// Participants (anonymous auth) can only create their own documents, once.
// Nothing can be updated or deleted from a client. Only the admin reads everything.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Keep in sync with ADMIN_UID in frontend/src/lib/config.ts
    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'JgR6YKPFlxXYmHYlxPFCnkvzfHK2'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function str(value, max) {
      return value is string && value.size() <= max;
    }

    // Question ids from frontend/src/study/content.ts.
    function answers(value) {
      return value is map
        && value.keys().hasOnly(['summary', 'ease', 'number_meaning', 'option_difference', 'prefer_single_price', 'approach', 'warning_seen',
                                 'confidence', 'unclear', 'most_confusing', 'would_use', 'self_employed'])
        && answer(value, 'summary') && answer(value, 'ease') && answer(value, 'number_meaning') && answer(value, 'option_difference')
        && answer(value, 'prefer_single_price') && answer(value, 'approach') && answer(value, 'warning_seen') && answer(value, 'confidence')
        && answer(value, 'unclear') && answer(value, 'most_confusing') && answer(value, 'would_use') && answer(value, 'self_employed');
    }

    // Free text, a choice id or a 1-5 rating; null when skipped.
    function answer(value, key) {
      return !(key in value)
        || value[key] == null
        || str(value[key], 2000)
        || (value[key] is int && value[key] >= 1 && value[key] <= 5);
    }

    match /participants/{uid}/runs/{runId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && hasExactly(request.resource.data, ['uid', 'runId', 'lang', 'startedAt', 'appVersion', 'userAgent', 'viewport', 'language'])
        && request.resource.data.uid == uid
        && request.resource.data.runId == runId
        && runId.size() <= 64
        && request.resource.data.lang in ['de', 'en']
        && request.resource.data.startedAt == request.time
        && str(request.resource.data.appVersion, 64)
        && str(request.resource.data.userAgent, 500)
        && str(request.resource.data.viewport, 20)
        && str(request.resource.data.language, 20);

      match /tasks/{taskId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && taskId in ['1', '2', '3', '4']
          && hasExactly(request.resource.data, ['uid', 'runId', 'task', 'status', 'durationMs', 'clicks', 'endScreen', 'answers', 'appVersion', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.runId == runId
          && request.resource.data.task is int && string(request.resource.data.task) == taskId
          && request.resource.data.status in ['reached', 'self', 'stuck']
          && request.resource.data.durationMs is int && request.resource.data.durationMs >= 0
          && request.resource.data.clicks is int && request.resource.data.clicks >= 0 && request.resource.data.clicks < 100000
          && str(request.resource.data.endScreen, 32)
          && answers(request.resource.data.answers)
          && str(request.resource.data.appVersion, 64)
          && request.resource.data.createdAt == request.time;
      }

      match /final/{finalId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && finalId == 'final'
          && hasExactly(request.resource.data, ['uid', 'runId', 'answers', 'totalMs', 'path', 'events', 'choices', 'appVersion', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.runId == runId
          && answers(request.resource.data.answers)
          && request.resource.data.totalMs is int && request.resource.data.totalMs >= 0
          && request.resource.data.path is list && request.resource.data.path.size() <= 500
          && request.resource.data.events is list && request.resource.data.events.size() <= 500
          && request.resource.data.choices is map && request.resource.data.choices.size() <= 40
          && str(request.resource.data.appVersion, 64)
          && request.resource.data.createdAt == request.time;
      }
    }

    // Admin export uses collection group queries across all participants.
    match /{path=**}/runs/{runId} {
      allow read: if isAdmin();
    }
    match /{path=**}/tasks/{taskId} {
      allow read: if isAdmin();
    }
    match /{path=**}/final/{finalId} {
      allow read: if isAdmin();
    }
  }
}
